rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owns(uid) {
      return verifiedUser() && request.auth.uid == uid;
    }

    function validHandle(handle) {
      return handle is string && handle.matches('^[a-z0-9_]{3,20}$');
    }

    function chatMember() {
      return verifiedUser() && request.auth.uid in resource.data.memberIds;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;

      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && validHandle(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.displayName == request.resource.data.displayName;

      // One-time migration for accounts created before username onboarding.
      allow update: if owns(uid)
        && !('username' in resource.data)
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && validHandle(request.resource.data.username)
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.displayName == request.resource.data.displayName;

      allow delete: if false;
    }

    match /usernames/{handle} {
      allow get: if verifiedUser() && validHandle(handle);
      allow list: if false;

      allow create: if verifiedUser()
        && validHandle(handle)
        && !exists(/databases/$(database)/documents/usernames/$(handle))
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == handle
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == handle
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName == request.resource.data.displayName;

      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow get, list: if chatMember();

      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'memberIds', 'createdAt', 'updatedAt',
          'lastMessageText', 'lastMessageAt',
          'lastMessageSenderId', 'lastMessageId'
        ])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string
        && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && chatId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && request.auth.uid in request.resource.data.memberIds
        && exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageSenderId == ''
        && request.resource.data.lastMessageId == '';

      allow update: if chatMember()
        && request.resource.data.keys().hasOnly([
          'memberIds', 'createdAt', 'updatedAt',
          'lastMessageText', 'lastMessageAt',
          'lastMessageSenderId', 'lastMessageId'
        ])
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessageText', 'lastMessageAt',
          'lastMessageSenderId', 'lastMessageId'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() > 0
        && request.resource.data.lastMessageText.size() <= 4000
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageId.size() > 0
        && request.resource.data.lastMessageId != resource.data.lastMessageId
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text == request.resource.data.lastMessageText
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if verifiedUser()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        allow create: if verifiedUser()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
