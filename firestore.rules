rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User profile: each account can access only its own profile.
    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;

      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;

      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;

      allow delete: if false;
    }

    // The current Android build only listens for chats containing its UID.
    // Chat creation, message writes, groups, statuses and other collections
    // remain denied until their client flows and data contracts are implemented.
    match /chats/{chatId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false;

      match /{nestedCollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // Deny every collection not explicitly enabled above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
