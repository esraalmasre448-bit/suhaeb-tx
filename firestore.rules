rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function chatExists(chatId) { return exists(/databases/$(database)/documents/chats/$(chatId)); }
    function isMember(chatId) {
      return signedIn() && chatExists(chatId) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }
    function validText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.keys().hasOnly([
        'uid','displayName','username','photoUrl','bio','createdAt','updatedAt','lastSeenAt','online','privacy','fcmTokens'
      ]) && request.resource.data.uid == uid && validText(request.resource.data.displayName, 60);
      allow update: if owns(uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoUrl','bio','updatedAt','lastSeenAt','online','privacy','fcmTokens'
        ]);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt']);
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isMember(chatId);
      allow create: if signedIn() && request.resource.data.keys().hasOnly([
        'memberIds','createdBy','createdAt','type','title','photoUrl','lastMessage','lastMessageAt','updatedAt'
      ]) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 256
        && request.resource.data.type in ['direct','group'];
      allow update: if isMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastMessageAt','updatedAt','title','photoUrl'
        ])
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == resource.data.type;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId','type','text','mediaUrl','fileName','fileSize','createdAt','replyToId',
            'editedAt','deletedForEveryone','deliveredAt','readBy'
          ]) && request.resource.data.type in ['text','image','video','audio','file']
          && (!('text' in request.resource.data) ||
              (request.resource.data.text is string && request.resource.data.text.size() <= 10000))
          && (!('fileSize' in request.resource.data) ||
              (request.resource.data.fileSize is int && request.resource.data.fileSize <= 52428800));
        allow update: if isMember(chatId) && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text','editedAt','deletedForEveryone'
          ]);
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if isMember(chatId);
        allow create, update: if owns(uid) && isMember(chatId)
          && request.resource.data.keys().hasOnly(['typing','updatedAt'])
          && request.resource.data.typing is bool;
        allow delete: if owns(uid) && isMember(chatId);
      }
    }

    match /blocks/{uid}/blocked/{blockedUid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && request.resource.data.keys().hasOnly(['createdAt']);
      allow delete: if owns(uid);
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reporterId','targetUid','chatId','messageId','reason','details','createdAt'
        ]) && validText(request.resource.data.reason, 80);
      allow read, update, delete: if false;
    }

    match /statuses/{statusId} {
      allow read: if signedIn() && resource.data.expiresAt > request.time
        && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.visibleTo);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId','mediaUrl','caption','createdAt','expiresAt','visibleTo'
        ]) && request.resource.data.visibleTo is list
        && request.resource.data.visibleTo.size() <= 500;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}