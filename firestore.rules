rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Enforce the same verified-email requirement on the server,
    // not only in the Android UI.
    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owns(uid) {
      return verifiedUser() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;

      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;

      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;

      allow delete: if false;
    }

    // The current Android app only queries chats containing the signed-in UID.
    // Chat creation and all message/nested writes remain disabled until implemented.
    match /chats/{chatId} {
      allow get, list: if verifiedUser()
        && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false;

      match /{nestedCollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
